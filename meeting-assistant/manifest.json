{
  "manifest_version": 3,
  "name": "商談リアルタイム・アシスタント",
  "version": "0.1.0",
  "description": "Zoom(Web版)/Google Meet で相手の発言を文字起こしし、商談向けの回答候補をリアルタイム表示するChrome拡張。",
  "default_locale": "ja",
  "permissions": ["tabCapture", "offscreen", "storage", "activeTab", "tabs", "scripting"],
  "host_permissions": [
    "*://*.zoom.us/*",
    "*://meet.google.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://api.deepgram.com/*",
    "wss://api.deepgram.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.zoom.us/*", "*://meet.google.com/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "商談アシスタント",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/audio/pcm-worklet.js"],
      "matches": ["*://*.zoom.us/*", "*://meet.google.com/*"]
    }
  ]
}
