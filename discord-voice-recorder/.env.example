# Discord Bot のトークン（Developer Portal > Bot > Reset Token）
DISCORD_TOKEN=your-bot-token-here

# アプリケーション（クライアント）ID（Developer Portal > General Information > Application ID）
CLIENT_ID=your-application-id-here

# スラッシュコマンドを即時反映させたいサーバーのID（開発用・任意）
# 設定するとそのサーバー限定で即反映、未設定だとグローバル登録（反映に最大1時間）。
GUILD_ID=your-test-guild-id-here

# 人がVCに入った瞬間に自動で録音を開始する（true で有効・任意）。
# true にすると /record を打たなくても、誰かがVCに入ると自動で録音されます。
AUTO_RECORD=false

# 自動録音の対象VCを1つに限定したい場合のチャンネルID（任意・未設定なら全VC対象）。
AUTO_RECORD_CHANNEL_ID=

# この分数だけ「誰も喋らない」状態が続いたら自動停止・退出する（任意・0や未設定で無効）。
# 例: 5 にすると、5分間 発話が無ければ録音を止めてVCから抜けます。
SILENCE_TIMEOUT_MINUTES=0

# 起動時にスラッシュコマンドを自動登録する（任意）。
# PaaS/コンテナ運用で `npm run deploy` を別途流しづらい時に true にすると便利。
REGISTER_COMMANDS_ON_START=false
