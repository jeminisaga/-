# Discord Bot のトークン（Developer Portal > Bot > Reset Token）
DISCORD_TOKEN=your-bot-token-here

# アプリケーション（クライアント）ID（Developer Portal > General Information > Application ID）
CLIENT_ID=your-application-id-here

# スラッシュコマンドを即時反映させたいサーバーのID（開発用・任意）
# 設定するとそのサーバー限定で即反映、未設定だとグローバル登録（反映に最大1時間）。
GUILD_ID=your-test-guild-id-here
