{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prompt-manager",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prompt-manager",
      // `wrangler d1 create prompt-manager` の出力 ID に差し替える
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
