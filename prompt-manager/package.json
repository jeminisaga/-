{
  "name": "prompt-manager",
  "version": "0.1.0",
  "private": true,
  "description": "プロンプト管理ツール - Cloudflare Workers + D1 の MCP サーバー",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:init:local": "wrangler d1 execute prompt-manager --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute prompt-manager --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.120.0"
  }
}
